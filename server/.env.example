PORT=5000
# Local MongoDB for development, or your MongoDB Atlas connection string (required on Vercel), e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sitezo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/sitezo
# Only used for local development (not needed on Vercel, where site and API share one domain)
CLIENT_URL=http://localhost:5173

# --- Email notifications (Gmail) ---
# Gmail address that SENDS the notification
MAIL_USER=your-gmail-address@gmail.com
# Google App Password (16 letters) - NOT your normal Gmail password
MAIL_PASS=your-16-character-app-password
# Inbox that RECEIVES enquiries. Leave blank to use MAIL_USER.
NOTIFICATION_EMAIL=

# --- SMS notifications via Twilio: DISABLED for now ---
# SMS only ever sends when this is exactly "true" (and the four Twilio values below are filled in).
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=
