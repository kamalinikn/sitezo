PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sitezo
CLIENT_URL=http://localhost:5173

# --- Email notifications (Gmail) ---
# Gmail address that SENDS the notification
MAIL_USER=your-gmail-address@gmail.com
# Google App Password (16 letters) - NOT your normal Gmail password
MAIL_PASS=your-16-character-app-password
# Optional: where notifications are delivered. Leave blank to use MAIL_USER.
NOTIFICATION_EMAIL=

# --- SMS notifications via Twilio (optional; leave blank to skip SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=
